                        data-ga4-event='{ "event_name": "form_submit", "type": "feedback", "text": "Yes", "section": "Is this page useful?", "tool_name": "Is this page useful?", "page_location": "", "page_title": "No hearings allocated - Court information" }'>
                  Yes <span class="govuk-visually-hidden">this page is useful</span>
                </button>
              </li>
              <li class="gem-c-feedback__option-list-item">
                <button class="govuk-button gem-c-feedback__prompt-link"
                        aria-controls="feedback-form-is-page-useful-no-confirmation"
                        data-is-this-page-is-useful="false"
                        id="page-is-useful-no-button"
                        data-ga4-event='{ "event_name": "form_submit", "type": "feedback", "text": "No", "section": "Is this page useful?", "tool_name": "Is this page useful?", "page_location": "", "page_title": "No hearings allocated - Court information" }'>
                  No <span class="govuk-visually-hidden">this page is not useful</span>
                </button>
              </li>
            </ul>
          </div>
        </div>
        <div id="feedback-form-is-page-useful-yes-confirmation"
            class="govuk-!-display-none gem-c-feedback__prompt-questions gem-c-feedback__prompt-success"
             role="alert">
