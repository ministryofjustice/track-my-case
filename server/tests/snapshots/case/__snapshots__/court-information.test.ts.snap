          <span class="one-login-header__logotype">
            <!--[if gt IE 8]><!-->
              <svg focusable="false" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 324 60" height="30" width="162" fill="currentcolor" class="govuk-header__logotype" aria-label="GOV.UK"><title>GOV.UK</title>    <g>
                <circle cx="20" cy="17.6" r="3.7"></circle>
                <circle cx="10.2" cy="23.5" r="3.7"></circle>
