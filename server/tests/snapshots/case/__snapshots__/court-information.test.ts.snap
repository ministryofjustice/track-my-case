<script nonce="test-nonce" type="module">
  async function submitPageIsUseful(value) {
    const csrf = document.querySelector('input[name="_csrf"]').value
    const pageUrl = document.querySelector('input[name="_pageUrl"]').value
    const pageTitle = document.querySelector('input[name="_pageTitle"]').value
    const payload = {
      pageUseful: value,
      pageUrl: pageUrl,
      pageTitle: pageTitle,
      _csrf: csrf,
    }
    const response = await fetch('/feedback/decision', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'x-csrf-token': csrf,
      },
      body: JSON.stringify(payload),
      credentials: 'same-origin',
    })
    if (response.ok) {
      document.getElementById('feedback-form-options')?.classList.add('govuk-!-display-none')
      if (value === 'yes') {
        document.getElementById('feedback-form-is-page-useful-yes-confirmation')?.classList.remove('govuk-!-display-none')
      }
      if (value === 'no') {
        const noConfirmation = document.getElementById('feedback-form-is-page-useful-no-confirmation')
        noConfirmation?.classList.remove('govuk-!-display-none')
        // move focus to the revealed heading
        // so screen readers announce the new panel and swipe order continues correctly
        const noHeading = noConfirmation?.querySelector('h2')
        if (noHeading) {
          noHeading.focus()
        }
        const cancelFeedbackDecisionNoButton = document.getElementById('feedback-form-is-page-useful-no-confirmation-cancel-button')
        if (!cancelFeedbackDecisionNoButton?.getAttribute('listener')) {
          cancelFeedbackDecisionNoButton.addEventListener('click', async (e) => {
            e.preventDefault()
            document.getElementById('feedback-form-is-page-useful-no-confirmation')?.classList.add('govuk-!-display-none')
            const feedbackOptions = document.getElementById('feedback-form-options')
            feedbackOptions?.classList.remove('govuk-!-display-none')
            // restore focus to the options panel so screen reader swipe order picks up the Yes/No buttons again
            feedbackOptions?.focus()
          })
        }
      }
    } else {
      console.warn('Feedback decision failed', response.status)
    }
  }
  async function initFeedbackForm() {
    const yesButton = document.getElementById('page-is-useful-yes-button')
    if (!yesButton?.getAttribute('listener')) {
      yesButton?.addEventListener('click', async (e) => {
        e.preventDefault()
        await submitPageIsUseful('yes')
      })
    }
    const noButton = document.getElementById('page-is-useful-no-button')
    if (!noButton?.getAttribute('listener')) {
      noButton?.addEventListener('click', async (e) => {
        e.preventDefault()
        await submitPageIsUseful('no')
      })
    }
  }
  document.addEventListener('DOMContentLoaded', async () => {
    const feedbackForm = document.getElementById('feedback-form')
    await initFeedbackForm(feedbackForm)
  })
</script>
