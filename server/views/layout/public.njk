{% extends "govuk/template.njk" %}

{% block head %}
  <link href="{{ '/assets/css/index.css' | assetMap }}" rel="stylesheet" />
  <meta name="google-site-verification" content="ThvYU2V6sfjD-kyyj2zaZ8lZUxn-8qnsoiQCaFZHccQ" />
{% endblock %}

{% block pageTitle %}
  {{ (pageTitle + " – " + applicationName + " - GOV.UK") }}
{% endblock %}

{% block skipLink %}
  {{ super() }}
  {% if correctPasswordAndNotExpired %}
    <nav aria-label="Quick exit">
      <a href="https://www.bbc.co.uk/weather" class="govuk-skip-link" rel="nofollow noreferrer">Quick Exit (press Shift or Escape three times)</a>
    </nav>
  {% endif %}
  {% if not cookieAccepted %}
    {% include "partials/cookie-banner.njk" %}
  {% endif %}
{% endblock %}

{% block bodyStart %}
  {% include "partials/google-tag-manager-noscript.njk" %}
{% endblock %}

{% block header %}
  {% block headerStart %}{% endblock %}

  {% block govukHeader %}
    {% include "partials/header.njk" %}
  {% endblock %}

  {% block govukServiceNavigation %}{% endblock %}

  {% block headerEnd %}
    {% include "partials/govuk-phase-banner.njk" %}
    {% include "partials/back-link.njk" %}
    <div class="govuk-width-container">
      <nav class="hmrc-language-select" aria-label="Language switcher">
        <ul class="hmrc-language-select__list">
          {% for language in translations.options %}
            <li class="hmrc-language-select__list-item">
              {% if language.code === translations.currentLanguageCode %}
                <span class="govuk-visually-hidden">{{ language.changeLanguageText }}</span>
                <span aria-current="true">{{ language.label }}</span>
              {% else %}
                <a href="{{ language.href }}" hreflang="{{ language.code }}" lang="{{ language.code }}" rel="alternate" class="govuk-link">
                  <span class="govuk-visually-hidden">{{ language.changeLanguageText }}</span>
                  <span aria-hidden="true">{{ language.label }}</span>
                </a>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      </nav>
    </div>
  {% endblock %}
{% endblock %}

{% block content %}
{% endblock %}

{% block bodyEnd %}
  <script type="module" src="{{ '/assets/js/index.js' | assetMap }}" nonce="{{ cspNonce }}"></script>
{% endblock %}

{% block footer %}
  {% include "partials/footer.njk" %}
{% endblock %}
