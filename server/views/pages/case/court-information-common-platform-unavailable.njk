{% extends "layout/citizen-authenticated.njk" %}

{% set mainClasses = "app-container govuk-body" %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <h1 class="govuk-heading-l" title="{{ message }}">{{ t('court-info-unavailable:heading') }}</h1>
      <div class="govuk-notification-banner govuk-!-margin-bottom-6" role="alert" aria-labelledby="govuk-notification-banner-title" data-module="govuk-notification-banner">
        <div class="govuk-notification-banner__header">
          <h2 class="govuk-notification-banner__title" id="govuk-notification-banner-title">{{ t('court-info-unavailable:banner.title') }}</h2>
        </div>
        <div class="govuk-notification-banner__content">
          <h3 class="govuk-notification-banner__heading">{{ t('court-info-unavailable:banner.heading') }}</h3>
          <p class="govuk-body">{{ t('court-info-unavailable:banner.tryAgain') }}</p>
          <p class="govuk-body">{{ t('court-info-unavailable:banner.findCourt') }} <a href="{{ t('common:urls.findCourtTribunal') }}" class="govuk-link" target="_blank">{{ t('court-info-unavailable:banner.findCourtLink') }}</a>.</p>
          <p class="govuk-body">{{ t('court-info-unavailable:banner.contactPolice') }} <a href="{{ t('common:urls.policeForce') }}" class="govuk-link" target="_blank">{{ t('court-info-unavailable:banner.findPoliceLink') }}</a>.</p>
        </div>
      </div>

      {% include "pages/case/court-information-generic-summary.njk" %}

    </div>
  </div>

{% endblock %}
