{% extends "layout/citizen-authenticated.njk" %}

{% set mainClasses = "app-container govuk-body" %}

{% block content %}
  <div class="govuk-grid-row govuk-!-margin-bottom-6">
    <div class="govuk-grid-column-two-thirds">
      <div class="gem-c-heading govuk-!-margin-bottom-8">
        <h1 class="gem-c-heading__text govuk-heading-xl">
          {{ t('claiming-expenses:pageHeading') }}
        </h1>
      </div>
      <aside class="part-navigation-container" role="complementary">
        <nav data-module="ga4-link-tracker" aria-label="{{ t('claiming-expenses:nav.label') }}" class="gem-c-contents-list govuk-!-margin-bottom-4" data-ga4-link-tracker-module-started="true">
          <h2 class="gem-c-contents-list__title">
            {{ t('claiming-expenses:contentsHeading') }}
          </h2>
          <ol class="gem-c-contents-list__list">
            <li class="gem-c-contents-list__list-item gem-c-contents-list__list-item--dashed">
              <span class="gem-c-contents-list__list-item-dash" aria-hidden="true"></span>
              <a class="gem-c-contents-list__link govuk-link gem-c-force-print-link-styles" href="/case/victim-personal-statement">{{ t('claiming-expenses:nav.victimPersonalStatement') }}</a>
            </li>
            <li class="gem-c-contents-list__list-item gem-c-contents-list__list-item--dashed gem-c-contents-list__list-item--active" aria-current="true">
              <span class="gem-c-contents-list__list-item-dash" aria-hidden="true"></span>
              {{ t('claiming-expenses:nav.claimingExpenses') }}
            </li>
            <li class="gem-c-contents-list__list-item gem-c-contents-list__list-item--dashed">
              <span class="gem-c-contents-list__list-item-dash" aria-hidden="true"></span>
              <a class="gem-c-contents-list__link govuk-link gem-c-force-print-link-styles" href="/case/special-measures">{{ t('claiming-expenses:nav.specialMeasures') }}</a>
            </li>
            <li class="gem-c-contents-list__list-item gem-c-contents-list__list-item--dashed">
              <span class="gem-c-contents-list__list-item-dash" aria-hidden="true"></span>
              <a class="gem-c-contents-list__link govuk-link gem-c-force-print-link-styles" href="/case/requesting-court-hearing-transcript">{{ t('claiming-expenses:nav.requestingTranscript') }}</a>
            </li>
            <li class="gem-c-contents-list__list-item gem-c-contents-list__list-item--dashed">
              <span class="gem-c-contents-list__list-item-dash" aria-hidden="true"></span>
              <a class="gem-c-contents-list__link govuk-link gem-c-force-print-link-styles" href="/case/understand-compensation">{{ t('claiming-expenses:nav.understandCompensation') }}</a>
            </li>
            <li class="gem-c-contents-list__list-item gem-c-contents-list__list-item--dashed">
              <span class="gem-c-contents-list__list-item-dash" aria-hidden="true"></span>
              <a class="gem-c-contents-list__link govuk-link gem-c-force-print-link-styles" href="/case/return-property">{{ t('claiming-expenses:nav.returnProperty') }}</a>
            </li>
            <li class="gem-c-contents-list__list-item gem-c-contents-list__list-item--dashed">
              <span class="gem-c-contents-list__list-item-dash" aria-hidden="true"></span>
              <a class="gem-c-contents-list__link govuk-link gem-c-force-print-link-styles" href="/case/victims-code">{{ t('claiming-expenses:nav.victimsCode') }}</a>
            </li>
          </ol>
        </nav>
      </aside>
    </div>
  </div>
  <div class="govuk-grid-row govuk-!-margin-bottom-6">
    <div class="govuk-grid-column-two-thirds">
      <h2 class="govuk-heading-l">{{ t('claiming-expenses:heading') }}</h2>
      <p class="govuk-body">{{ t('claiming-expenses:intro') }}</p>

      <h3 class="govuk-heading-m">{{ t('claiming-expenses:whoCanClaimHeading') }}</h3>
      <p class="govuk-body">{{ t('claiming-expenses:whoCanClaimLead') }}</p>
      <ul class="govuk-list govuk-list--bullet">
        {% for item in t('claiming-expenses:whoCanClaimItems', {returnObjects: true}) %}
          <li>{{ item }}</li>
        {% endfor %}
      </ul>

      <h3 class="govuk-heading-m">{{ t('claiming-expenses:whatYouCanClaimHeading') }}</h3>
      <p class="govuk-body">{{ t('claiming-expenses:whatYouCanClaimLead') }}</p>
      <ul class="govuk-list govuk-list--bullet">
        {% for item in t('claiming-expenses:whatYouCanClaimItems', {returnObjects: true}) %}
          <li>{{ item }}</li>
        {% endfor %}
      </ul>
      <p class="govuk-body">{{ t('claiming-expenses:claimLimits') }}</p>
      <p class="govuk-body">{{ t('claiming-expenses:receiptsRequired') }}</p>

      <h3 class="govuk-heading-m">{{ t('claiming-expenses:howToClaimHeading') }}</h3>
      <p class="govuk-body">{{ t('claiming-expenses:howToClaimIntro') }}</p>
      <p class="govuk-body">{{ t('claiming-expenses:howToClaimLead') }}</p>
      <ul class="govuk-list govuk-list--bullet">
        {% for item in t('claiming-expenses:howToClaimItems', {returnObjects: true}) %}
          <li>{{ item | safe }}</li>
        {% endfor %}
      </ul>

      <h3 class="govuk-heading-m">{{ t('claiming-expenses:findOutMoreHeading') }}</h3>
      <p class="govuk-body">{{ t('claiming-expenses:findOutMoreText') }} <a href="{{ t('claiming-expenses:urls.claimWitnessExpenses') }}" class="govuk-link" target="_blank">{{ t('claiming-expenses:findOutMoreLinkText') }}</a>.</p>
      <p class="govuk-body">{{ t('claiming-expenses:victimSupportText') }} <a href="{{ t('claiming-expenses:urls.claimWitnessExpenses') }}" class="govuk-link" target="_blank">{{ t('claiming-expenses:victimSupportLinkText') }}</a>.</p>
    </div>
  </div>
{% endblock %}
