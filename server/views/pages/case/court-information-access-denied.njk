{% extends "layout/citizen-authenticated.njk" %}

{% set mainClasses = "app-container govuk-body" %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <h1 class="govuk-heading-l" title="{{ message }}">{{ t('court-info-access-denied:heading') }}</h1>

      <p class="govuk-body">
        {{ t('court-info-access-denied:para1') }}
      </p>
      <p class="govuk-body">
        {{ t('court-info-access-denied:para2') }} <a class="govuk-link" href="{{ t('common:urls.findCourtTribunal') }}" target="_blank">{{ t('court-info-access-denied:findCourtLink') }}</a>.
      </p>
    </div>
  </div>

{% endblock %}
