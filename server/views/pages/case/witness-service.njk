{% extends "layout/citizen-authenticated.njk" %}

{% set mainClasses = "app-container govuk-body" %}

{% block content %}
  <div class="govuk-grid-row govuk-!-margin-bottom-6">
    <div class="govuk-grid-column-two-thirds">
      <div class="gem-c-heading govuk-!-margin-bottom-8">
        <h1 class="gem-c-heading__text govuk-heading-xl">
          {{ t('witness-service:heading.main') }}
        </h1>
      </div>
      <aside class="part-navigation-container" role="complementary">
        <nav data-module="ga4-link-tracker" aria-label="Pages in this guide" class="gem-c-contents-list govuk-!-margin-bottom-4" data-ga4-link-tracker-module-started="true">
          <h2 class="gem-c-contents-list__title">
            {{ t('witness-service:contents.title') }}
          </h2>
          <ol class="gem-c-contents-list__list">
            <li class="gem-c-contents-list__list-item gem-c-contents-list__list-item--dashed">
              <span class="gem-c-contents-list__list-item-dash" aria-hidden="true"></span>
              <a class="gem-c-contents-list__link govuk-link gem-c-force-print-link-styles" href="/case/victim-support-links">{{ t('witness-service:contents.victimSupportLink') }}</a>
            </li>
            <li class="gem-c-contents-list__list-item gem-c-contents-list__list-item--dashed gem-c-contents-list__list-item--active" aria-current="true">
              <span class="gem-c-contents-list__list-item-dash" aria-hidden="true"></span>
              {{ t('witness-service:contents.currentItem') }}
            </li>
          </ol>
        </nav>
      </aside>
    </div>
  </div>
  <div class="govuk-grid-row govuk-!-margin-bottom-6">
    <div class="govuk-grid-column-two-thirds">
      <h2 class="govuk-heading-l">{{ t('witness-service:section.heading') }}</h2>
      <p class="govuk-body">{{ t('witness-service:section.intro') }}</p>

      <h3 class="govuk-heading-m">{{ t('witness-service:whatTheyCanDo.heading') }}</h3>
      <p>{{ t('witness-service:whatTheyCanDo.intro') }}</p>
      <ul class="govuk-list govuk-list--bullet">
        {% for item in t('witness-service:whatTheyCanDo.practicalItems', {returnObjects: true}) %}
          <li>{{ item }}</li>
        {% endfor %}
      </ul>
      <p>{{ t('witness-service:whatTheyCanDo.emotionalIntro') }}</p>
      <ul class="govuk-list govuk-list--bullet">
        {% for item in t('witness-service:whatTheyCanDo.emotionalItems', {returnObjects: true}) %}
          <li>{{ item }}</li>
        {% endfor %}
      </ul>
      <p class="govuk-body">{{ t('witness-service:whatTheyCanDo.impartial') }}</p>

      <h3 class="govuk-heading-m">{{ t('witness-service:findOutMore.heading') }}</h3>

        <a href="{{ t('common:urls.witnessServiceHelp') }}"
           class="govuk-link" target="_blank">{{ t('witness-service:findOutMore.linkText') }}</a></p>
  </div>
{% endblock %}
