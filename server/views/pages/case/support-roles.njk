{% extends "layout/citizen-authenticated.njk" %}

{% set mainClasses = "app-container govuk-body" %}

{% block content %}
  <div class="govuk-grid-row govuk-!-margin-bottom-6">
    <div class="govuk-grid-column-two-thirds">
      <div class="gem-c-heading govuk-!-margin-bottom-8">
        <h1 class="gem-c-heading__text govuk-heading-xl">
          {{ t('support-roles:heading.main') }}
        </h1>
      </div>
      <aside class="part-navigation-container" role="complementary">
        <nav data-module="ga4-link-tracker" aria-label="Pages in this guide" class="gem-c-contents-list govuk-!-margin-bottom-4" data-ga4-link-tracker-module-started="true">
          <h2 class="gem-c-contents-list__title">
            {{ t('support-roles:contents.title') }}
          </h2>
          <ol class="gem-c-contents-list__list">
            <li class="gem-c-contents-list__list-item gem-c-contents-list__list-item--dashed gem-c-contents-list__list-item--active" aria-current="true">
              <span class="gem-c-contents-list__list-item-dash" aria-hidden="true"></span>
              {{ t('support-roles:contents.keyRoles') }}
            </li>
            <li class="gem-c-contents-list__list-item gem-c-contents-list__list-item--dashed">
              <span class="gem-c-contents-list__list-item-dash" aria-hidden="true"></span>
              <a class="gem-c-contents-list__link govuk-link gem-c-force-print-link-styles" href="{{ t('common:routes.victimsJourney') }}">{{ t('support-roles:contents.victimsJourney') }}</a>
            </li>
          </ol>
        </nav>
      </aside>
    </div>
  </div>
  <div class="govuk-grid-row govuk-!-margin-bottom-6">
    <div class="govuk-grid-column-two-thirds">
      <h2 class="govuk-heading-l">{{ t('support-roles:section.keyRoles.heading') }}</h2>
      <div class="promo-panel__image govuk-!-margin-bottom-6">
        <img src="/assets/images/cjc-banner.jpg" alt="" class="promo-panel__image-content" />
      </div>
      <p class="govuk-body">{{ t('support-roles:section.keyRoles.intro') }}</p>

      <h2 class="govuk-heading-m" id="police-officers">{{ t('support-roles:role.courtUshers.heading') }}</h2>
      <p class="govuk-body">{{ t('support-roles:role.courtUshers.body') }}</p>

      <h2 class="govuk-heading-m" id="crown-prosecution-service-prosecutors">{{ t('support-roles:role.cpsprosecutors.heading') }}</h2>
      <p class="govuk-body">{{ t('support-roles:role.cpsprosecutors.body') }}</p>

      <h2 class="govuk-heading-m" id="crown-prosecution-service-prosecutors">{{ t('support-roles:role.defenceSolicitors.heading') }}</h2>
      <p class="govuk-body">{{ t('support-roles:role.defenceSolicitors.body') }}</p>

      <h2 class="govuk-heading-m" id="crown-prosecution-service-prosecutors">{{ t('support-roles:role.judgesMagistrates.heading') }}</h2>
      <p class="govuk-body">{{ t('support-roles:role.judgesMagistrates.body') }}</p>

      <h2 class="govuk-heading-m" id="crown-prosecution-service-prosecutors">{{ t('support-roles:role.legalAdvisers.heading') }}</h2>
      <p class="govuk-body">{{ t('support-roles:role.legalAdvisers.body') }}</p>

      <h2 class="govuk-heading-m" id="crown-prosecution-service-prosecutors">{{ t('support-roles:role.policeOfficers.heading') }}</h2>
      <p class="govuk-body">{{ t('support-roles:role.policeOfficers.body') }}</p>

      <h2 class="govuk-heading-m" id="crown-prosecution-service-prosecutors">{{ t('support-roles:role.policeWitnessCareofficers.heading') }}</h2>
      <p class="govuk-body">{{ t('support-roles:role.policeWitnessCareofficers.body') }}</p>

      <h2 class="govuk-heading-m" id="crown-prosecution-service-prosecutors">{{ t('support-roles:role.probationOfficers.heading') }}</h2>
      <p class="govuk-body">{{ t('support-roles:role.probationOfficers.body') }}</p>

      <h2 class="govuk-heading-m" id="crown-prosecution-service-prosecutors">{{ t('support-roles:role.victimCaseworkers.heading') }}</h2>
      <p class="govuk-body">{{ t('support-roles:role.victimCaseworkers.body') }}</p>

      <h2 class="govuk-heading-m" id="crown-prosecution-service-prosecutors">{{ t('support-roles:role.witnessServiceVolunteers.heading') }}</h2>
      <p class="govuk-body">{{ t('support-roles:role.witnessServiceVolunteers.body') }}</p>
    </div>
  </div>
{% endblock %}
