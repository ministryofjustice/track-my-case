{% extends "layout/citizen-authenticated.njk" %}

{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/inset-text/macro.njk" import govukInsetText %}

{% set mainClasses = "app-container govuk-body" %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {% if error %}
        <div class="govuk-error-summary" aria-labelledby="error-summary-title" role="alert" tabindex="-1" data-module="govuk-error-summary">
          <h2 class="govuk-error-summary__title" id="error-summary-title">{{ t('court-information:errorSummaryTitle') }}</h2>
          <div class="govuk-error-summary__body">
            {{ error }}
          </div>
        </div>
      {% endif %}

      <h1 class="govuk-heading-l govuk-!-margin-bottom-2" title="{{ selectedUrn }}">{{ t('court-information:heading') }}</h1>

    {% if hearingData %}

      {% if displayHearing %}
        {{ govukInsetText({
          html: '<span class="tmc-data-testid-inset-title"><strong>' + (hearingData.hearingStartDateMessage.title) + "</strong></span>" +
          '<p class="govuk-hint govuk-!-margin-top-2 tmc-data-testid-inset-description">' + hearingData.hearingStartDateMessage.description + '</p>'
        }) }}
      {% endif %}

      {% set rows = [{
        key: { text: t('court-information:urnLabel') },
        value: {
          text: selectedUrn,
          classes: 'tmc-data-testid-urn'
        }
      }] %}

      {% if displayHearing %}
        {% set rows = rows.concat([
          {
            key: { text: t('court-information:hearingType') },
            value: { html: '<span class="tmc-data-testid-hearing-type">' + hearingData.hearingType + '</span>' +
              '<p class="govuk-hint govuk-!-margin-top-3 tmc-data-testid-hearing-type-description">' + t('court-information:hearingTypeHint') + '</p>'
            }
          },
          {
            key: { text: t('court-information:expectedStartDate') },
            value: {
              html: hearingData.sittingStart,
              classes: 'tmc-data-testid-expected-start-date'
            }
          }
        ]) %}
        {% if hearingData.hearingOption === 'COURT_SITTINGS' %}
          {% set rows = rows.concat([
            {
              key: { text: t('court-information:expectedToLast') },
              value: { html: '<span class="tmc-data-testid-expected-to-last" title="' + hearingData.sittingPeriodTooltip + '">' + hearingData.sittingPeriod + '</span>' }
            }
          ]) %}
        {% endif %}
      {% endif %}

      {% set rows = rows.concat([
        {
          key: { text: t('court-information:courtName') },
          value: {
            html: '<span class="tmc-data-testid-court-name">' + hearingData.location.courtHouseName + '</span>' ~
            '<p class="govuk-hint govuk-!-margin-top-3 tmc-data-testid-court-name-description">' + t('court-information:courtNameHint') + '</p>'
          }
        },
        {
          key: { text: t('court-information:courtAddress') },
          value: {
            html: hearingData.location.addressLines | join(', ') ~
            ", " ~ hearingData.location.postcode ~ ", " ~ hearingData.location.country,
            classes: 'tmc-data-testid-court-address'
          }
        },
        {
          key: { text: t('court-information:courtInfo') },
          value: {
            html: '<a href="' + courtUrl + '" target="_blank">' + t('court-information:courtInfoLink') + '</a>',
            classes: 'tmc-data-testid-court-information'
          }
        }
      ]) %}

      <div class="govuk-!-margin-bottom-6">
        {{ govukSummaryList({
          rows: rows
        }) }}
      </div>

      <p class="govuk-body">
        <a href="{{ t('common:urls.findCourtTribunal') }}" target="_blank">{{ t('court-information:findOtherCourts') }}</a>
      </p>

      {% include "pages/case/court-information-generic-summary.njk" %}

    {% else %}
      <p>{{ t('court-information:noCourtInfo') }}</p>
    {% endif %}

    </div>
  </div>

{% endblock %}
