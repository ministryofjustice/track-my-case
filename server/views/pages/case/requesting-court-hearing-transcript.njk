{% extends "layout/citizen-authenticated.njk" %}

{% set mainClasses = "app-container govuk-body" %}

{% block content %}
  <div class="govuk-grid-row govuk-!-margin-bottom-6">
    <div class="govuk-grid-column-two-thirds">
      <div class="gem-c-heading govuk-!-margin-bottom-8">
        <h1 class="gem-c-heading__text govuk-heading-xl">
          {{ t('requesting-transcript:heading') }}
        </h1>
      </div>
      <aside class="part-navigation-container" role="complementary">
        <nav data-module="ga4-link-tracker" aria-label="{{ t('requesting-transcript:nav.ariaLabel') }}" class="gem-c-contents-list govuk-!-margin-bottom-4" data-ga4-link-tracker-module-started="true">
          <h2 class="gem-c-contents-list__title">
            {{ t('requesting-transcript:nav.contentsHeading') }}
          </h2>
          <ol class="gem-c-contents-list__list">
            <li class="gem-c-contents-list__list-item gem-c-contents-list__list-item--dashed">
              <span class="gem-c-contents-list__list-item-dash" aria-hidden="true"></span>
              <a class="gem-c-contents-list__link govuk-link gem-c-force-print-link-styles" href="{{ t('common:routes.victimPersonalStatement') }}">{{ t('requesting-transcript:nav.victimPersonalStatement') }}</a>
            </li>
            <li class="gem-c-contents-list__list-item gem-c-contents-list__list-item--dashed">
              <span class="gem-c-contents-list__list-item-dash" aria-hidden="true"></span>
              <a class="gem-c-contents-list__link govuk-link gem-c-force-print-link-styles" href="{{ t('common:routes.claimingExpenses') }}">{{ t('requesting-transcript:nav.claimingExpenses') }}</a>
            </li>
            <li class="gem-c-contents-list__list-item gem-c-contents-list__list-item--dashed">
              <span class="gem-c-contents-list__list-item-dash" aria-hidden="true"></span>
              <a class="gem-c-contents-list__link govuk-link gem-c-force-print-link-styles" href="{{ t('common:routes.specialMeasures') }}">{{ t('requesting-transcript:nav.specialMeasures') }}</a>
            </li>
            <li class="gem-c-contents-list__list-item gem-c-contents-list__list-item--dashed gem-c-contents-list__list-item--active" aria-current="true">
              <span class="gem-c-contents-list__list-item-dash" aria-hidden="true"></span>
              {{ t('requesting-transcript:nav.requestingTranscript') }}
            </li>
            <li class="gem-c-contents-list__list-item gem-c-contents-list__list-item--dashed">
              <span class="gem-c-contents-list__list-item-dash" aria-hidden="true"></span>
              <a class="gem-c-contents-list__link govuk-link gem-c-force-print-link-styles" href="{{ t('common:routes.understandCompensation') }}">{{ t('requesting-transcript:nav.understandCompensation') }}</a>
            </li>
            <li class="gem-c-contents-list__list-item gem-c-contents-list__list-item--dashed">
              <span class="gem-c-contents-list__list-item-dash" aria-hidden="true"></span>
              <a class="gem-c-contents-list__link govuk-link gem-c-force-print-link-styles" href="{{ t('common:routes.returnProperty') }}">{{ t('requesting-transcript:nav.returnProperty') }}</a>
            </li>
            <li class="gem-c-contents-list__list-item gem-c-contents-list__list-item--dashed">
              <span class="gem-c-contents-list__list-item-dash" aria-hidden="true"></span>
              <a class="gem-c-contents-list__link govuk-link gem-c-force-print-link-styles" href="{{ t('common:routes.victimsCode') }}">{{ t('requesting-transcript:nav.victimsCode') }}</a>
            </li>
          </ol>
        </nav>
      </aside>
    </div>
  </div>
  <div class="govuk-grid-row govuk-!-margin-bottom-6">
    <div class="govuk-grid-column-two-thirds">
      <h2 class="govuk-heading-l govuk-!-margin-top-6">{{ t('requesting-transcript:section.heading') }}</h2>
      <p class="govuk-body">{{ t('requesting-transcript:section.intro1') }}</p>
      <p class="govuk-body">{{ t('requesting-transcript:section.intro2') }}</p>
      <p class="govuk-body">{{ t('requesting-transcript:section.intro3') }}</p>
      <p class="govuk-body">{{ t('requesting-transcript:section.intro4') }}</p>

      <h3 class="govuk-heading-m">{{ t('requesting-transcript:sentencing.heading') }}</h3>
      <p class="govuk-body">{{ t('requesting-transcript:sentencing.para1') }}</p>
      <p class="govuk-body">{{ t('requesting-transcript:sentencing.para2.before') }} <a href="https://caselaw.nationalarchives.gov.uk/" class="govuk-link" target="_blank">{{ t('requesting-transcript:sentencing.para2.link1Text') }}</a> {{ t('requesting-transcript:sentencing.para2.between') }} <a href="https://www.judiciary.uk/judgments/" class="govuk-link" target="_blank">{{ t('requesting-transcript:sentencing.para2.link2Text') }}</a>.</p>
      <p class="govuk-body">{{ t('requesting-transcript:sentencing.para3') }}</p>
      <ul class="govuk-list govuk-list--bullet">
        {% for item in t('requesting-transcript:sentencing.eligibleItems', {returnObjects: true}) %}
          <li>{{ item }}</li>
        {% endfor %}
      </ul>
      <p class="govuk-body">{{ t('requesting-transcript:sentencing.applyLead') }}</p>
      <ul class="govuk-list govuk-list--bullet">
        <li><a href="https://transcripts-of-judges-sentencing-remarks.form.service.justice.gov.uk/" class="govuk-link" target="_blank">{{ t('requesting-transcript:sentencing.applyOnlineLinkText') }}</a></li>
        <li><a href="https://www.gov.uk/government/publications/apply-for-a-transcript-of-a-judges-sentencing-remarks" class="govuk-link" target="_blank">{{ t('requesting-transcript:sentencing.applyFormLinkText') }}</a></li>
      </ul>
      <p class="govuk-body">{{ t('requesting-transcript:sentencing.para4') }}</p>
      <p class="govuk-body">{{ t('requesting-transcript:sentencing.para5') }}</p>

      <h3 class="govuk-heading-m">{{ t('requesting-transcript:fullHearing.heading') }}</h3>
      <p class="govuk-body">{{ t('requesting-transcript:fullHearing.para1.before') }} <a href="https://www.gov.uk/government/publications/order-a-transcript-of-court-or-tribunal-proceedings-form-ex107" class="govuk-link" target="_blank">{{ t('requesting-transcript:fullHearing.para1.linkText') }}</a> {{ t('requesting-transcript:fullHearing.para1.after') }}</p>
      <p class="govuk-body">{{ t('requesting-transcript:fullHearing.para2') }}</p>
      <p class="govuk-body">{{ t('requesting-transcript:fullHearing.para3') }}</p>
      <ul class="govuk-list govuk-list--bullet">
        <li>{{ t('requesting-transcript:fullHearing.returnItem1.before') }} <a href="https://www.gov.uk/find-court-tribunal" class="govuk-link" target="_blank">{{ t('requesting-transcript:fullHearing.returnItem1.linkText') }}</a> {{ t('requesting-transcript:fullHearing.returnItem1.after') }}</li>
        <li>{{ t('requesting-transcript:fullHearing.returnItem2') }}</li>
      </ul>
      <p class="govuk-body">{{ t('requesting-transcript:fullHearing.para4') }}</p>
    </div>
  </div>
{% endblock %}
