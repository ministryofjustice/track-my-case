      <h3 class="govuk-heading-s">{{ t('victims-code:right7.heading') }}</h3>
      <p class="govuk-body">{{ t('victims-code:right7.para1') }}</p>

      <h3 class="govuk-heading-s">{{ t('victims-code:right8.heading') }}</h3>
      <p class="govuk-body">{{ t('victims-code:right8.para1') }}</p>
      <p class="govuk-body">{{ t('victims-code:right8.para2') }}</p>

      <h3 class="govuk-heading-s">{{ t('victims-code:right9.heading') }}</h3>
      <p class="govuk-body">{{ t('victims-code:right9.para1') }}</p>

      <h3 class="govuk-heading-s">{{ t('victims-code:right10.heading') }}</h3>
      <p class="govuk-body">{{ t('victims-code:right10.para1') }}</p>

      <h3 class="govuk-heading-s">{{ t('victims-code:right11.heading') }}</h3>
      <p class="govuk-body">{{ t('victims-code:right11.para1') }}</p>
      <p class="govuk-body">{{ t('victims-code:right11.para2') }}</p>

      <h3 class="govuk-heading-s">{{ t('victims-code:right12.heading') }}</h3>
      <p class="govuk-body">{{ t('victims-code:right12.para1') }}</p>

      <p class="govuk-body">
        {{ t('victims-code:fullCodeLink.before') }}
        <a href="{{ t('common:urls.victimsCode') }}" target="_blank" rel="noopener noreferrer">
          {{ t('victims-code:fullCodeLink.linkText') }}
        </a>
      </p>

    </div>
  </div>
{% endblock %}
