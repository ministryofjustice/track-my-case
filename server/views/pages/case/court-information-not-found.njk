{% extends "layout/citizen-authenticated.njk" %}

{% set mainClasses = "app-container govuk-body" %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      <h1 class="govuk-heading-l" title="{{ message }}">{{ t('court-info-not-found:heading') }}</h1>

      <p class="govuk-body"><strong>{{ t('court-info-not-found:urnLabel') }}</strong> {{ selectedUrn }}</p>
      <p class="govuk-body">{{ t('court-info-not-found:checkUrn') }}</p>
      <p class="govuk-body">{{ t('court-info-not-found:cantFindUrn') }} <a class="govuk-link" href="{{ t('common:urls.findCourtTribunal') }}" target="_blank">{{ t('court-info-not-found:searchAllCourts') }}</a>.</p>
      <a href="/case/search" role="button" id="search-again-button" class="govuk-button govuk-button--primary" draggable="false" data-module="govuk-button">{{ t('court-info-not-found:searchAgain') }}</a>
    </div>
  </div>

{% endblock %}
