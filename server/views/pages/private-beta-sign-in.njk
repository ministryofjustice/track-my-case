{% extends "layout/citizen-authenticated.njk" %}

{% from "govuk/components/error-summary/macro.njk" import govukErrorSummary %}
{% from "govuk/components/password-input/macro.njk" import govukPasswordInput %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% set passwordError = (errorList or []) | selectattr("href", "equalto", "#password") | first %}

{% set mainClasses = "app-container govuk-body" %}

{% block content %}
  <div class="govuk-grid-row govuk-!-margin-bottom-6">
    <div class="govuk-grid-column-two-thirds">
      {% if errorList %}
        {{ govukErrorSummary({
          titleText: t('private-beta-sign-in:errorSummaryTitle'),
          errorList: errorList
        }) }}
      {% endif %}

      <form method="post" action="{{ privateBetaSignInApi }}" novalidate>
        <input type="hidden" name="_csrf" value="{{ csrfToken }}">

          <div class="govuk-form-group {{ 'govuk-form-group--error' if passwordError }}">
               <h1 class="govuk-label-wrapper">
                 <label class="govuk-label govuk-label--l" for="password">
                   {{ t('private-beta-sign-in:label', {applicationName: applicationName}) }}
                 </label>
               </h1>

               <p class="govuk-body">
                  {{ t('private-beta-sign-in:intro', {applicationName: applicationName}) }}
               </p>

               <p class="govuk-hint">
                 {{ t('private-beta-sign-in:hint') }}
               </p>

               {{ govukPasswordInput({
                 classes: "govuk-input--width-20",
                 id: "password",
                 name: "password",
                 type: "password",
                 autocomplete: "current-password",
                 errorMessage: passwordError
               }) }}
             </div>

        {{ govukButton({
          text: t('private-beta-sign-in:signInButton')
        }) }}
      </form>
      <details class="govuk-details">
        <summary class="govuk-details__summary">
          <span class="govuk-details__summary-text">{{ t('private-beta-sign-in:detailsSummary') }}</span>
        </summary>
        <div class="govuk-details__text">
          {{ t('private-beta-sign-in:detailsText') }}
        </div>
      </details>
    </div>
  </div>
{% endblock %}
