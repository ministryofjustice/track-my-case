{% extends "layout/public.njk" %}
{%- from "govuk/components/button/macro.njk" import govukButton %}

{% set mainClasses = "app-container govuk-body" %}

{% block content %}

  <script nonce="{{ cspNonce }}" type="module">

    function openNewTabWithDashboard(url, authenticated) {
      return function() {
        if (authenticated) {
          window.location.href = url;
        } else {
          const dash = window.open(url, '_blank', 'noopener,noreferrer')
          if (window.history?.length > 1) {
            window.location.replace('about:blank')
          } else {
            window.location.replace('about:blank')
          }
        }
      }
    }

    document.addEventListener('DOMContentLoaded', () => {
        const buttonElement = document.getElementById('start-now-button')
        if (buttonElement) {
          const url = buttonElement.dataset.url || '/case/dashboard'
          const authenticated = buttonElement.dataset.authenticated === "true"
          buttonElement.removeEventListener('click', openNewTabWithDashboard(url, authenticated))
          buttonElement.addEventListener('click', openNewTabWithDashboard(url, authenticated))
        }
      },
    )

  </script>

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">{{ applicationName }}</h1>

      <p class="govuk-body">{{ t('home:introLead') }}</p>
      <ul class="govuk-list govuk-list--bullet">
        {% for item in t('home:introItems', {returnObjects: true}) %}
          <li>{{ item }}</li>
        {% endfor %}
      </ul>

      <h2 class="govuk-heading-m">{{ t('home:whoHeading') }}</h2>
      <p class="govuk-body">{{ t('home:whoLead') }}</p>
      <ul class="govuk-list govuk-list--bullet">
        {% for item in t('home:whoItems', {returnObjects: true}) %}
          <li>{{ item }}</li>
        {% endfor %}
      </ul>

      <p class="govuk-body">{{ t('home:notConfident') }}</p>

      <h2 class="govuk-heading-m">{{ t('home:whatYouNeedHeading') }}</h2>
      <p class="govuk-body">{{ t('home:whatYouNeed') }}</p>

      <h2 class="govuk-heading-m">{{ t('home:safetyHeading') }}</h2>
      <p class="govuk-body">{{ t('home:safety1', {applicationName: applicationName}) }}</p>
      <p class="govuk-body">{{ t('home:safety2') }}</p>
      <p class="govuk-body">{{ t('home:safety3') }}</p>

      {{ govukButton({
        text: t('home:startButton'),
        type: "button",
        isStartButton: true,
        attributes: {
          id: "start-now-button",
          "data-url": "/case/dashboard",
          "data-authenticated": correctPasswordAndNotExpired
        }
      }) }}

    </div>

    <div class="govuk-grid-column-one-third">
      <aside class="govuk-prototype-kit-common-templates-related-items" role="complementary">
        <h2 class="govuk-heading-m" id="subsection-title">{{ t('home:relatedHeading') }}</h2>
        <nav role="navigation" aria-labelledby="subsection-title">
          <ul class="govuk-list govuk-!-font-size-16">
            {% for item in t('home:relatedItems', {returnObjects: true}) %}
              <li><a href="{{ item.url }}" class="govuk-link" target="_blank">{{ item.text }}</a></li>
            {% endfor %}
          </ul>
        </nav>
      </aside>
    </div>
  </div>
{% endblock %}
